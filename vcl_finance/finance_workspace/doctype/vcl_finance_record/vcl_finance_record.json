    },
    {
      "fieldname": "identity",
      "label": "Identity",
      "fieldtype": "Data",
      "unique": 1,
      "hidden": 1
    },
    {
      "fieldname": "source_doctype",
      "label": "Source type",
      "fieldtype": "Link",
      "options": "DocType",
      "read_only": 1
    },
    {
      "fieldname": "source_document",
      "label": "Source document",
      "fieldtype": "Dynamic Link",
      "options": "source_doctype",
      "read_only": 1
    },
    {
      "fieldname": "payload_json",
      "label": "Evidence and version data",
      "fieldtype": "Long Text",
      "reqd": 1,
      "read_only": 1
    }
